# =============================================================================
# IndicMoE-4B Environment Configuration
# =============================================================================
# 
# Instructions:
# 1. Copy this file to .env: cp env.example .env
# 2. Fill in your actual values (especially HUGGINGFACE_TOKEN)
# 3. Never commit the .env file (it's in .gitignore)

# =============================================================================
# HuggingFace Configuration
# =============================================================================

# Get your token from: https://huggingface.co/settings/tokens
# Required for downloading datasets and models
HUGGINGFACE_TOKEN=your_token_here


# =============================================================================
# Data Processing Configuration
# =============================================================================

# Directory paths (inside container)
RAW_DATA_DIR=/workspace/data/raw
PROCESSED_DATA_DIR=/workspace/data/processed
CACHE_DIR=/workspace/data/cache


# =============================================================================
# Model Configuration
# =============================================================================

# Model name for training
MODEL_NAME=IndicMoE-4B-FP4

# Tokenizer to use
# Options:
# 1. Custom trained (RECOMMENDED for best quality):
#    - /workspace/tokenizers/indicmoe_128k  (128k vocab, optimized for Indic+Code)
#    - /workspace/tokenizers/indicmoe_256k  (256k vocab, higher quality)
# 2. Pre-trained:
#    - meta-llama/Llama-3.2-1B (32k vocab, default)
#    - meta-llama/Llama-3.2-3B (128k vocab)
#    - microsoft/phi-2 (51k vocab)
#    - google/gemma-2b (256k vocab)
#
# To train custom tokenizer: See TOKENIZER_TRAINING.md
# Command: python code/tokenizer/train_custom_tokenizer.py --vocab-size 128000
TOKENIZER_NAME=meta-llama/Llama-3.2-1B


# =============================================================================
# Processing Configuration
# =============================================================================

# Batch size for tokenization (adjust based on available memory)
# - 24GB VRAM: 1000-2000
# - 16GB VRAM: 500-1000
# - 8GB VRAM: 250-500
BATCH_SIZE=2000

# Maximum sequence length for tokenization
MAX_SEQUENCE_LENGTH=2048

# Number of worker processes for data loading
NUM_WORKERS=4


# =============================================================================
# Tokenizer Training Configuration (Optional)
# =============================================================================

# Vocabulary size for custom tokenizer
# Recommended: 128k-256k for multilingual + code
# Research shows: 128k optimal, 256k if quality priority, 512k overkill for 4B model
# TOKENIZER_VOCAB_SIZE=128000

# Maximum samples for tokenizer training corpus
# 1M samples = ~30 min training, 5M samples = ~2 hours
# TOKENIZER_TRAINING_SAMPLES=1000000


# =============================================================================
# Checkpoint Configuration (Optional)
# =============================================================================

# Save checkpoint every N samples (default: 1000)
# CHECKPOINT_INTERVAL=1000

# Maximum retry attempts for failed datasets (default: 3)
# MAX_RETRIES=3


# =============================================================================
# Logging Configuration (Optional)
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# Weights & Biases (optional for experiment tracking)
# WANDB_API_KEY=your_wandb_key
# WANDB_PROJECT=indicmoe-4b
# WANDB_ENTITY=your_username

